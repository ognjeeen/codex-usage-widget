<Application x:Class="CodexUsageWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Resources/WidgetTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="UiFont">pack://application:,,,/CodexUsageWidget;component/Assets/Fonts/#Source Han Sans CN</FontFamily>
            <FontFamily x:Key="NumericFont">pack://application:,,,/CodexUsageWidget;component/Assets/Fonts/#Helvetica Neue LT Std</FontFamily>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
