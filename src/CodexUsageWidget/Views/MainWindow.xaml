<Window x:Class="CodexUsageWidget.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexUsageWidget.Views.Controls"
        xmlns:localization="clr-namespace:CodexUsageWidget.Views.Localization"
        Title="{localization:Loc App_MainTitle}"
        Width="390"
        Height="290"
        MinWidth="390"
        MinHeight="290"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Border x:Name="WidgetSurface"
            Margin="12"
            CornerRadius="16"
            Background="{DynamicResource WidgetSurfaceBrush}"
            BorderBrush="{DynamicResource WidgetBorderBrush}"
            BorderThickness="1"
            MouseLeftButtonDown="Widget_OnMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="4"
                              Opacity="0.38"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Grid Margin="16,6,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Codex"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <controls:ActivityDotsIndicator x:Name="WidgetActivityDots"
                                                        Margin="18,0,0,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="{localization:Loc Main_ActivityRunning}"
                                                        AutomationProperties.Name="{localization:Loc Main_ActivityRunning}"
                                                        DotBrush="{DynamicResource AccentDataBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <Ellipse Width="5"
                                 Height="5"
                                 Fill="{Binding StatusBrush}"
                                 Margin="0,1,6,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource SupportingText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button ToolTip="{localization:Loc Main_RefreshUsage}"
                            Style="{StaticResource IconButton}"
                            Click="RefreshButton_OnClick">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M12.5,5.5 A5,5 0 1 0 13,10 M12.5,2.5 L12.5,5.5 L9.5,5.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="DensityButton"
                            ToolTip="{localization:Loc Main_ShowDetails}"
                            AutomationProperties.Name="{localization:Loc Main_ToggleLayout}"
                            Style="{StaticResource IconButton}"
                            Click="DensityButton_OnClick">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M4.5,7 L8,10 L11.5,7"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="DensityGlyphRotation"
                                                         CenterX="8"
                                                         CenterY="8" />
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button ToolTip="{localization:Loc Main_UseTaskbarLabel}"
                            Style="{StaticResource IconButton}"
                            Click="HideButton_OnClick">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M5,8 L11,8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button ToolTip="{localization:Loc Common_Exit}"
                            Style="{StaticResource IconButton}"
                            Click="CloseButton_OnClick">
                        <Path Style="{StaticResource CloseGlyph}" />
                    </Button>
                </StackPanel>
            </Grid>

            <controls:CompactUsageView x:Name="CompactView" Grid.Row="1" />
            <controls:DetailedUsageView x:Name="DetailedView"
                                        Grid.Row="1"
                                        Visibility="Collapsed" />

            <Border Grid.Row="2"
                    Margin="16,0,16,0"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Text="{Binding UpdatedText}"
                               VerticalAlignment="Center"
                               Style="{StaticResource SupportingText}"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextTertiary}" />
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button x:Name="SettingsButton"
                                ToolTip="{localization:Loc Common_Settings}"
                                AutomationProperties.Name="{localization:Loc Common_Settings}"
                                Style="{StaticResource IconButton}"
                                Click="SettingsButton_OnClick">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="20" Height="20">
                                    <Path Data="M1.91099 7.38266C2.28028 6.24053 2.88863 5.19213 3.69133 4.30364C3.82707 4.15339 4.04002 4.09984 4.23069 4.16802L6.14897 4.85392C6.66905 5.03977 7.24131 4.76883 7.42716 4.24875C7.44544 4.19762 7.45952 4.14507 7.46925 4.09173L7.83471 2.08573C7.87104 1.88627 8.02422 1.7285 8.22251 1.6863C8.8027 1.5628 9.39758 1.5 10.0003 1.5C10.6026 1.5 11.1971 1.56273 11.7769 1.68607C11.9752 1.72824 12.1284 1.88591 12.1648 2.08529L12.5313 4.09165C12.6303 4.63497 13.1511 4.9951 13.6944 4.89601C13.7479 4.88627 13.8004 4.87219 13.8515 4.85395L15.7698 4.16802C15.9605 4.09984 16.1734 4.15339 16.3092 4.30364C17.1119 5.19213 17.7202 6.24053 18.0895 7.38266C18.1518 7.57534 18.0918 7.78658 17.9374 7.91764L16.3825 9.23773C15.9615 9.5952 15.9101 10.2263 16.2675 10.6473C16.3027 10.6887 16.3411 10.7271 16.3825 10.7623L17.9374 12.0824C18.0918 12.2134 18.1518 12.4247 18.0895 12.6173C17.7202 13.7595 17.1119 14.8079 16.3092 15.6964C16.1734 15.8466 15.9605 15.9002 15.7698 15.832L13.8515 15.1461C13.3315 14.9602 12.7592 15.2312 12.5733 15.7512C12.5551 15.8024 12.541 15.8549 12.5312 15.9085L12.1648 17.9147C12.1284 18.1141 11.9752 18.2718 11.7769 18.3139C11.1971 18.4373 10.6026 18.5 10.0003 18.5C9.39758 18.5 8.8027 18.4372 8.22251 18.3137C8.02422 18.2715 7.87104 18.1137 7.83471 17.9143L7.46926 15.9084C7.37018 15.365 6.8494 15.0049 6.30608 15.104C6.25265 15.1137 6.20011 15.1278 6.14906 15.1461L4.23069 15.832C4.04002 15.9002 3.82707 15.8466 3.69133 15.6964C2.88863 14.8079 2.28028 13.7595 1.91099 12.6173C1.84869 12.4247 1.90876 12.2134 2.06313 12.0824L3.61798 10.7623C4.03897 10.4048 4.09046 9.77373 3.73299 9.35274C3.69784 9.31135 3.65937 9.27288 3.618 9.23775L2.06313 7.91764C1.90876 7.78658 1.84869 7.57534 1.91099 7.38266ZM2.97154 7.37709L4.26523 8.47546C4.34803 8.54576 4.42496 8.62269 4.49526 8.70548C5.2102 9.54746 5.10721 10.8096 4.26521 11.5246L2.97154 12.6229C3.26359 13.4051 3.68504 14.1322 4.21648 14.7751L5.81246 14.2044C5.91473 14.1679 6.01982 14.1397 6.1