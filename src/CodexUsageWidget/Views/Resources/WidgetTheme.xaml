                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="PressedSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonRoot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.45"
                                                         Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="ButtonSurface"
                                Background="{Binding PrimaryBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderBrush="{Binding PrimaryBorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" />
                        <Border x:Name="HoverSurface"
                                Background="{Binding HoverBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderBrush="{Binding HoverBorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Border x:Name="PressedSurface"
                                Background="{Binding PressedBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderBrush="{Binding PrimaryBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
