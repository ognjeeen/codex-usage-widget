<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CodexUsageWidget.Views.Controls">
    <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TextSecondary" Color="#B5B5B5" />
    <SolidColorBrush x:Key="TextTertiary" Color="#969696" />
    <SolidColorBrush x:Key="CardBackground" Color="#292929" />
    <SolidColorBrush x:Key="CardBorder" Color="#343434" />
    <SolidColorBrush x:Key="WidgetSurfaceBrush" Color="#FA1F1F1F" />
    <SolidColorBrush x:Key="WidgetBorderBrush" Color="#343434" />
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#424242" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#252525" />
    <SolidColorBrush x:Key="CodeSurfaceBrush" Color="#171717" />
    <SolidColorBrush x:Key="DividerBrush" Color="#303030" />
    <SolidColorBrush x:Key="IconForegroundBrush" Color="#A8A8A8" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#343434" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#454545" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#414141" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#292929" />
    <SolidColorBrush x:Key="IconHoverBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="IconPressedBrush" Color="#363636" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="UsageNormalBrush" Color="#E7E7E7" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#646464" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#858585" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#F5232323" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#F0B3B8" />
    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#24DDA56D" />
    <SolidColorBrush x:Key="NoticeForegroundBrush" Color="#E6B47D" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#242424" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#454545" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#363636" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#3B3B3B" />
    <SolidColorBrush x:Key="MenuCheckBorderBrush" Color="#565656" />
    <SolidColorBrush x:Key="MenuCheckForegroundBrush" Color="#FFFFFF" />
    <Color x:Key="AccentPrimaryColor">#3B78D8</Color>
    <Color x:Key="AccentPrimaryBorderColor">#5B91E5</Color>
    <Color x:Key="AccentPrimaryHoverColor">#4A88E8</Color>
    <Color x:Key="AccentPrimaryHoverBorderColor">#76ADF2</Color>
    <Color x:Key="AccentPrimaryPressedColor">#2E63B5</Color>
    <Color x:Key="AccentDataColor">#75A7F0</Color>
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentPrimaryBorderBrush" Color="{StaticResource AccentPrimaryBorderColor}" />
    <SolidColorBrush x:Key="AccentDataBrush" Color="{StaticResource AccentDataColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid Background="Transparent">
                        <Border Margin="8"
                                Padding="10,8"
                                Background="{DynamicResource TooltipBackgroundBrush}"
                                BorderBrush="{DynamicResource TooltipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Opacity="0.22"
                                                  Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogWindow" TargetType="Window">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>

    <Style x:Key="DialogSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DialogSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DialogBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource IconForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ButtonRoot">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.12">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <VisualTransition To="MouseOver" GeneratedDuration="0:0:0.14">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.06" />
                                    <VisualTransition From="Pressed" GeneratedDuration="0:0:0.08" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="PressedSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonRoot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="PressedSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonRoot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="PressedSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonRoot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="PressedSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonRoot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.45"
                                                         Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7" />
                        <Border x:Name="HoverSurface"
                                Background="{DynamicResource IconHoverBrush}"
                                CornerRadius="7"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Border x:Name="PressedSurface"
                                Background="{DynamicResource IconPressedBrush}"
                                CornerRadius="7"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogTitle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="DialogCloseButton"
           TargetType="Button"
           BasedOn="{StaticResource IconButton}">
        <Setter Property="Margin" Value="12,-4,-4,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="CloseGlyph" TargetType="Path">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Data" Value="M 1,1 L 9,9 M 9,1 L 1,9" />
        <Setter Property="Stretch" Value="Fill" />
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>

    <Style x:Key="SectionCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

