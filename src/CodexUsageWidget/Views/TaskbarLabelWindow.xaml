<Window x:Class="CodexUsageWidget.Views.TaskbarLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexUsageWidget.Views.Controls"
        xmlns:localization="clr-namespace:CodexUsageWidget.Views.Localization"
        Width="102"
        Height="40"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/TaskbarMenuTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="TaskbarTextPrimaryBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="TaskbarTextSecondaryBrush" Color="#D4D4D4" />
            <SolidColorBrush x:Key="TaskbarLabelHoverBrush" Color="#18FFFFFF" />
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="LabelSurface"
            CornerRadius="6"
            Cursor="Hand"
            Padding="8,0,0,0"
            ContextMenuService.Placement="Top"
            ContextMenuService.VerticalOffset="-2"
            ToolTipService.Placement="Top"
            ToolTipService.VerticalOffset="-8"
            MouseLeftButtonUp="LabelSurface_OnMouseLeftButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#01000000" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TaskbarLabelHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.ContextMenu>
            <ContextMenu x:Name="TaskbarMenu"
                         Style="{StaticResource TaskbarContextMenu}"
                         Opened="TaskbarMenu_OnOpened"
                         Closed="TaskbarMenu_OnClosed">
                <ContextMenu.Resources>
                    <Style TargetType="MenuItem"
                           BasedOn="{StaticResource TaskbarContextMenuItem}" />
                    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}"
                           TargetType="Separator"
                           BasedOn="{StaticResource TaskbarContextMenuSeparator}" />
                </ContextMenu.Resources>
                <MenuItem Header="{localization:Loc Taskbar_OpenWidget}" Click="OpenMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Data="M 2.5,3.5 H 13.5 V 12.5 H 2.5 Z M 2.5,6 H 13.5"
                              Style="{StaticResource TaskbarMenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{localization:Loc Common_Refresh}" Click="RefreshMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Data="M 13.5,5.5 V 2.5 M 13.5,2.5 H 10.5 M 13,7 A 5.5,5.5 0 1 0 13,10.5"
                              Style="{StaticResource TaskbarMenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="ActivityPreviewMenuItem"
                          Header="{localization:Loc Taskbar_PreviewActivity}"
                          IsCheckable="True"
                          Visibility="Collapsed"
                          Click="ActivityPreviewMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Data="M 5,3 L 12.5,8 L 5,13 Z"
                              Style="{StaticResource TaskbarMenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{localization:Loc Tray_Settings}" Click="SettingsMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Data="M 8,5.2 A 2.8,2.8 0 1 0 8,10.8 A 2.8,2.8 0 1 0 8,5.2 M 8,2 V 3.3 M 8,12.7 V 14 M 2,8 H 3.3 M 12.7,8 H 14 M 3.8,3.8 L 4.8,4.8 M 11.2,11.2 L 12.2,12.2 M 12.2,3.8 L 11.2,4.8 M 4.8,11.2 L 3.8,12.2"
                              Style="{StaticResource TaskbarMenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{localization:Loc Taskbar_UseDesktopWidget}" Click="DesktopModeMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Data="M 2,3.5 H 14 V 11 H 2 Z M 6,13.5 H 10 M 8,11 V 13.5"
                              Style="{StaticResource TaskbarMenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{localization:Loc Tray_CheckUpdates}" Click="CheckForUpdatesMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Data="M 6,3 H 13 V 10 M 13,3 L 5,11 M 10,13 H 3 V 6"
                              Style="{StaticResource TaskbarMenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{localization:Loc Common_Exit}" Click="ExitMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Data="M 6,3 H 3 V 13 H 6 M 9.5,5 L 12.5,8 L 9.5,11 M 12.5,8 H 6"
                              Style="{StaticResource TaskbarMenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="12"
                   TextOptions.TextFormattingMode="Ideal">
            <InlineUIContainer BaselineAlignment="Center">
                <controls:ActivityDotsIndicator x:Name="ActivityDots"
                                                Margin="0,0,6,0"
                                                DotVerticalOffset="1.625"
                                                ShowIdleDot="True" />
            </InlineUIContainer><Run
                Text="Codex"
                FontWeight="Medium"
                Foreground="{DynamicResource TaskbarTextPrimaryBrush}" /><Run
                Text=" " /><Run
                x:Name="UsageText"
                Text="--%"
                FontWeight="SemiBold"
                Typography.NumeralAlignment="Tabular"
                Foreground="{DynamicResource TaskbarTextSecondaryBrush}" />
        </TextBlock>
    </Border>
</Window>
