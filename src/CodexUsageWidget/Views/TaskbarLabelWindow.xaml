<Window x:Class="CodexUsageWidget.Views.TaskbarLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexUsageWidget.Views.Controls"
        Width="102"
        Height="40"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/TaskbarMenuTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="LabelSurface"
            CornerRadius="6"
            Cursor="Hand"
            Padding="8,0,0,0"
            ToolTipService.Placement="Top"
            ToolTipService.VerticalOffset="-8"
            MouseLeftButtonUp="LabelSurface_OnMouseLeftButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#01000000" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#18FFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.ContextMenu>
            <ContextMenu Style="{StaticResource TaskbarContextMenu}">
                <ContextMenu.Resources>
                    <Style TargetType="MenuItem"
                           BasedOn="{StaticResource TaskbarContextMenuItem}" />
                    <Style TargetType="Separator"
                           BasedOn="{StaticResource TaskbarContextMenuSeparator}" />
                </ContextMenu.Resources>
                <MenuItem Header="Open widget" Click="OpenMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Data="M 2.5,3.5 H 13.5 V 12.5 H 2.5 Z M 2.5,6 H 13.5"
                              Style="{StaticResource TaskbarMenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Refresh" Click="RefreshMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Data="M 13.5,5.5 V 2.5 M 13.5,2.5 H 10.5 M 13,7 A 5.5,5.5 0 1 0 13,10.5"
                              Style="{StaticResource TaskbarMenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Activity dots..." Click="ActivityDotsMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Data="M 2.5,8 H 2.6 M 8,8 H 8.1 M 13.5,8 H 13.6"
                              StrokeThickness="3"
                              Style="{StaticResource TaskbarMenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="ActivityPreviewMenuItem"
                          Header="Preview activity animation"
                          IsCheckable="True"
                          Visibility="Collapsed"
                          Click="ActivityPreviewMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Data="M 5,3 L 12.5,8 L 5,13 Z"
                              Style="{StaticResource TaskbarMenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Use desktop widget" Click="DesktopModeMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Data="M 2,3.5 H 14 V 11 H 2 Z M 6,13.5 H 10 M 8,11 V 13.5"
                              Style="{StaticResource TaskbarMenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="StartWithWindowsMenuItem"
                          Header="Start with Windows"
                          IsCheckable="True"
                          Click="StartWithWindowsMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Data="M 8,2 V 8 M 4.5,4.5 A 5,5 0 1 0 11.5,4.5"
                              Style="{StaticResource TaskbarMenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Exit" Click="ExitMenuItem_OnClick">
                    <MenuItem.Icon>
                        <Path Data="M 6,3 H 3 V 13 H 6 M 9.5,5 L 12.5,8 L 9.5,11 M 12.5,8 H 6"
                              Style="{StaticResource TaskbarMenuIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="12"
                   TextOptions.TextFormattingMode="Ideal">
            <InlineUIContainer BaselineAlignment="Center">
                <controls:ActivityDotsIndicator x:Name="ActivityDots"
                                                Margin="0,0,6,0"
                                                DotVerticalOffset="1.625"
                                                ShowIdleDot="True" />
            </InlineUIContainer><Run
                Text="Codex"
                FontWeight="Medium"
                Foreground="#F2F2F2" /><Run
                Text=" " /><Run
                x:Name="UsageText"
                Text="--%"
                FontWeight="SemiBold"
                Typography.NumeralAlignment="Tabular"
                Foreground="#D4D4D4" />
        </TextBlock>
    </Border>
</Window>
