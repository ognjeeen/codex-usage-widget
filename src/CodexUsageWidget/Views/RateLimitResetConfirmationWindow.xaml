<Window x:Class="CodexUsageWidget.Views.RateLimitResetConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexUsageWidget.Views.Controls"
        xmlns:localization="clr-namespace:CodexUsageWidget.Views.Localization"
        Title="{localization:Loc Usage_ResetConfirmTitle}"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">
    <Border Style="{StaticResource DialogSurface}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{localization:Loc Usage_ResetConfirmTitle}"
                           Style="{StaticResource DialogTitle}" />
                <Button Grid.Column="1"
                        ToolTip="{localization:Loc Common_Close}"
                        IsCancel="True"
                        Style="{StaticResource DialogCloseButton}">
                    <Path Style="{StaticResource CloseGlyph}" />
                </Button>
            </Grid>

            <TextBlock x:Name="DescriptionText"
                       Grid.Row="1"
                       Margin="0,10,0,18"
                       TextWrapping="Wrap"
                       Style="{StaticResource SupportingText}"
                       FontSize="12" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{localization:Loc Common_Cancel}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Style="{StaticResource DialogButton}" />
                <controls:AccentButton Content="{localization:Loc Usage_UseReset}"
                                       IsDefault="True"
                                       Style="{StaticResource PrimaryDialogButton}"
                                       Click="UseResetButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
