<Window x:Class="CodexUsageWidget.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="468"
        Height="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">
    <Window.Resources>
        <Style x:Key="SettingsOptionCard" TargetType="RadioButton">
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="18"
                                      Height="18"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                                    <Ellipse Stroke="{DynamicResource IconForegroundBrush}"
                                             StrokeThickness="1.4" />
                                    <Ellipse x:Name="SelectedDot"
                                             Width="8"
                                             Height="8"
                                             Fill="{DynamicResource AccentPrimaryBrush}"
                                             Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentPrimaryBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter TargetName="SelectedDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentPrimaryBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.48" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsToggleCard" TargetType="CheckBox">
            <Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Card"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Border x:Name="ToggleTrack"
                                        Grid.Column="1"
                                        Width="40"
                                        Height="22"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <Ellipse x:Name="ToggleThumb"
                                             Width="16"
                                             Height="16"
                                             Margin="2"
                                             HorizontalAlignment="Left"
                                             Fill="{DynamicResource TextSecondary}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentPrimaryBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack"
                                        Property="Background"
                                        Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter TargetName="ToggleTrack"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter TargetName="ToggleThumb"
                                        Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentPrimaryBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource DialogSurface}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="5"
                              Opacity="0.34"
                              Color="#000000" />
        </Border.Effect>
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Settings"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="Choose how Codex Usage Widget looks and behaves."
                               Margin="0,3,0,0"
                               Style="{StaticResource SupportingText}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Margin="12,-4,-4,0"
                        VerticalAlignment="Top"
                        ToolTip="Close"
                        IsCancel="True"
                        Style="{StaticResource IconButton}">
                    <Path Width="10"
                          Height="10"
                          Data="M 1,1 L 9,9 M 9,1 L 1,9"
                          Stretch="Fill"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,22,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource SlimScrollViewer}">
              <StackPanel Margin="0,0,5,0">
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Theme"
                               Margin="0,8,0,0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="Use the Windows setting or keep the widget in one theme."
                               Margin="0,3,0,0"
                               Style="{StaticResource SupportingText}" />
                </StackPanel>

              <StackPanel>
                <RadioButton x:Name="SystemThemeOption"
                             GroupName="Theme"
                             AutomationProperties.Name="Use Windows theme"
                             Checked="ThemeOption_OnChecked"
                             Style="{StaticResource SettingsOptionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Use Windows setting" FontWeight="SemiBold" />
                            <TextBlock Text="Changes with your Windows app theme"
                                       Margin="0,3,0,0"
                                       Style="{StaticResource SupportingText}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Width="46"
                                Height="30"
                                BorderBrush="#85878C"
                                BorderThickness="1"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Background="#F7F7F8" />
                                <Border Grid.Column="1" Background="#252525" />
                            </Grid>
                        </Border>
                    </Grid>
                </RadioButton>

                <RadioButton x:Name="LightThemeOption"
                             GroupName="Theme"
                             AutomationProperties.Name="Use light theme"
                             Checked="ThemeOption_OnChecked"
                             Style="{StaticResource SettingsOptionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Light" FontWeight="SemiBold" />
                            <TextBlock Text="Bright surfaces with dark text"
                                       Margin="0,3,0,0"
                                       Style="{StaticResource SupportingText}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Width="46"
                                Height="30"
                                Background="#F7F7F8"
                                BorderBrush="#C9CBD0"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Border Width="24"
                                    Height="4"
                                    Background="#3B78D8"
                                    CornerRadius="2" />
                        </Border>
                    </Grid>
                </RadioButton>

                <RadioButton x:Name="DarkThemeOption"
                             GroupName="Theme"
                             AutomationProperties.Name="Use dark theme"
                             Checked="ThemeOption_OnChecked"
                             Style="{StaticResource SettingsOptionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Dark" FontWeight="SemiBold" />
                            <TextBlock Text="Dark surfaces with light text"
                                       Margin="0,3,0,0"
                                       Style="{StaticResource SupportingText}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Width="46"
                                Height="30"
                                Background="#252525"
                                BorderBrush="#4B4B4B"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Border Width="24"
                                    Height="4"
                                    Background="#75A7F0"
                                    CornerRadius="2" />
                        </Border>
                    </Grid>
                </RadioButton>
              </StackPanel>

              <StackPanel Margin="0,10,0,14">
                  <TextBlock Text="Widget layout"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimary}" />
                  <TextBlock Text="Choose how much information the desktop widget shows."
                             Margin="0,3,0,0"
                             Style="{StaticResource SupportingText}" />
              </StackPanel>

              <Grid>
                  <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <RadioButton x:Name="CompactLayoutOption"
                               GroupName="WidgetLayout"
                               Margin="0,0,4,8"
                               AutomationProperties.Name="Use compact widget layout"
                               Checked="WidgetLayoutOption_OnChecked"
                               Style="{StaticResource SettingsOptionCard}">
                      <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Compact" FontWeight="SemiBold" />
                          <TextBlock Text="Summary at a glance"
                                     Margin="0,3,0,0"
                                     Style="{StaticResource SupportingText}" />
                      </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="DetailedLayoutOption"
                               Grid.Column="1"
                               GroupName="WidgetLayout"
                               Margin="4,0,0,8"
                               AutomationProperties.Name="Use detailed widget layout"
                               Checked="WidgetLayoutOption_OnChecked"
                               Style="{StaticResource SettingsOptionCard}">
                      <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Detailed" FontWeight="SemiBold" />
                          <TextBlock Text="Full usage breakdown"
                                     Margin="0,3,0,0"
                                     Style="{StaticResource SupportingText}" />
                      </StackPanel>
                  </RadioButton>
              </Grid>

              <Border Height="1"
                      Margin="0,2,0,10"
                      Background="{DynamicResource DividerBrush}" />

              <StackPanel Margin="0,0,0,14">
                  <TextBlock Text="USAGE" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="Displayed limit"
                             Margin="0,8,0,0"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimary}" />
                  <TextBlock Text="Choose the limit shown in the widget, taskbar label, and tray icon."
                             Margin="0,3,0,0"
                             TextWrapping="Wrap"
                             Style="{StaticResource SupportingText}" />
              </StackPanel>

              <StackPanel>
                  <RadioButton x:Name="FiveHourLimitOption"
                               GroupName="DisplayedLimit"
                               AutomationProperties.Name="Display 5-hour limit"
                               Checked="DisplayedLimitOption_OnChecked"
                               Style="{StaticResource SettingsOptionCard}"
                               ToolTip="Codex did not return a global 5h limit for this account.">
                      <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="5h limit" FontWeight="SemiBold" />
                          <TextBlock Text="Show the global five-hour usage window"
                                     Margin="0,3,0,0"
                                     Style="{StaticResource SupportingText}" />
                      </StackPanel>
                  </RadioButton>

                  <RadioButton x:Name="WeeklyLimitOption"
                               GroupName="DisplayedLimit"
                               AutomationProperties.Name="Display weekly limit"
                               Checked="DisplayedLimitOption_OnChecked"
                               Style="{StaticResource SettingsOptionCard}">
                      <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Weekly limit" FontWeight="SemiBold" />
                          <TextBlock Text="Show the global weekly usage window"
                                     Margin="0,3,0,0"
                                     Style="{StaticResource SupportingText}" />
                      </StackPanel>
                  </RadioButton>

                  <RadioButton x:Name="MostConstrainedLimitOption"
                               GroupName="DisplayedLimit"
                               AutomationProperties.Name="Display most constrained limit"
                               Checked="DisplayedLimitOption_OnChecked"
                               Style="{StaticResource SettingsOptionCard}">
                      <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Most constrained" FontWeight="SemiBold" />
                          <TextBlock Text="Show whichever available limit has the least remaining"
                                     Margin="0,3,0,0"
                                     Style="{StaticResource SupportingText}" />
                      </StackPanel>
                  </RadioButton>
              </StackPanel>

              <Border Height="1"
                      Margin="0,2,0,10"
                      Background="{DynamicResource DividerBrush}" />

              <StackPanel>
                  <TextBlock Text="GENERAL" Style="{StaticResource SectionTitle}" />
                  <CheckBox x:Name="StartWithWindowsOption"
                            Margin="0,14,0,0"
                            AutomationProperties.Name="Start with Windows"
                            Checked="StartWithWindowsOption_OnChanged"
                            Unchecked="StartWithWindowsOption_OnChanged"
                            Style="{StaticResource SettingsToggleCard}">
                      <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                          <TextBlock Text="Launch the widget when you sign in"
                                     Margin="0,3,0,0"
                                     Style="{StaticResource SupportingText}" />
                      </StackPanel>
                  </CheckBox>
              </StackPanel>
             </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
