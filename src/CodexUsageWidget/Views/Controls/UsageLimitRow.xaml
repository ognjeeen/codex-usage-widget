<UserControl x:Class="CodexUsageWidget.Views.Controls.UsageLimitRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="56">
    <Grid Margin="0,2,0,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}"
                       Margin="0,0,8,0"
                       TextTrimming="CharacterEllipsis"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding RemainingText}"
                       Style="{StaticResource SupportingText}"
                       Typography.NumeralAlignment="Tabular"
                       Margin="8,0,0,0" />
        </Grid>
        <ProgressBar Grid.Row="1"
                     Margin="0,7,0,6"
                     Maximum="100"
                     Value="{Binding UsedPercent, Mode=OneWay}"
                     Style="{StaticResource UsageProgress}" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ResetText}"
                       Style="{StaticResource SupportingText}"
                       Foreground="{DynamicResource TextTertiary}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding UsedText}"
                       Style="{StaticResource SupportingText}"
                       Margin="8,0,0,0"
                       Foreground="{DynamicResource TextTertiary}" />
        </Grid>
    </Grid>
</UserControl>
