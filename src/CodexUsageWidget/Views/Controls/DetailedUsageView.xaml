<UserControl x:Class="CodexUsageWidget.Views.Controls.DetailedUsageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CodexUsageWidget.Views.Controls">
    <ScrollViewer x:Name="DetailsScrollViewer"
                  Margin="16,4,10,8"
                  Padding="0,0,4,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Style="{StaticResource SlimScrollViewer}">
        <StackPanel>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OVERVIEW" Style="{StaticResource SectionTitle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding HeadlineRemainingText}"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </Grid>
                    <Border Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,0,0,8"
                            Padding="9,6"
                            Background="{DynamicResource NoticeBackgroundBrush}"
                            CornerRadius="6">
                        <TextBlock Text="{Binding WarningText}"
                                   Style="{StaticResource SupportingText}"
                                   Foreground="{DynamicResource NoticeForegroundBrush}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding GeneralLimits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:UsageLimitRow />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Visibility="{Binding HasAccountMetrics, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="CREDITS &amp; LIMITS"
                               Margin="0,0,0,9"
                               Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding AccountMetrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}"
                                               Style="{StaticResource SupportingText}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               Text="{Binding Value}"
                                               TextAlignment="Right"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="11.5"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Visibility="{Binding HasTokenActivity, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TOKEN ACTIVITY" Style="{StaticResource SectionTitle}" />
                        <TextBlock Grid.Column="1"
                                   Text="Not quota consumption"
                                   Style="{StaticResource SupportingText}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextTertiary}" />
                    </Grid>

                    <ItemsControl Height="48"
                                  Margin="0,0,0,9"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom"
                                  ItemsSource="{Binding TokenActivity.DailyBars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="10"
                                      Height="48"
                                      ToolTipService.InitialShowDelay="150"
                                      ToolTipService.BetweenShowDelay="0"
                                      ToolTipService.ShowDuration="15000"
                                      ToolTipService.Placement="MousePoint"
                                      ToolTipService.HorizontalOffset="10"
                                      ToolTipService.VerticalOffset="10">
                                    <Grid.ToolTip>
                                        <ToolTip DataContext="{Binding PlacementTarget.DataContext,
                                                                       RelativeSource={RelativeSource Self}}"
                                                 Style="{StaticResource TokenActivityToolTip}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DateText}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Text="{Binding TokensText}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentDataBrush}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding PeakComparisonText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextTertiary}" />
                                            </StackPanel>
                                        </ToolTip>
                                    </Grid.ToolTip>
                                    <Border Width="8"
                                            Height="{Binding Height}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Background="{DynamicResource AccentDataBrush}"
                                            CornerRadius="2,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding TokenActivity.Metrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3,10,5">
                                    <TextBlock Text="{Binding Label}"
                                               Style="{StaticResource SupportingText}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiary}" />
                                    <TextBlock Text="{Binding Value}"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Visibility="{Binding HasModelLimits, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="MODEL-SPECIFIC LIMITS"
                               Margin="0,0,0,8"
                               Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding ModelLimits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:UsageLimitRow />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
