<UserControl x:Class="CodexUsageWidget.Views.Controls.CompactUsageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:CodexUsageWidget.Views.Localization">
    <UserControl.Resources>
        <Style x:Key="ReferenceUsageProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="9" />
            <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryUsageBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4.5" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4.5">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ProgressValueWidthConverter}">
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15,3,15,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16.5,0">
                <TextBlock Text="{Binding PrimaryLimitLabel}"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding PrimaryRemainingNumberText}"
                               Margin="0,3,0,-3"
                               FontFamily="{StaticResource NumericFont}"
                               FontSize="42"
                               FontWeight="Bold"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{Binding PrimaryRemainingBrush}" />
                    <TextBlock Text="%"
                               Margin="1.5,0,0,0"
                               VerticalAlignment="Bottom"
                               FontFamily="{StaticResource NumericFont}"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{Binding PrimaryRemainingBrush}" />
                    <TextBlock Text="{localization:Loc Usage_RemainingShort}"
                               Margin="6,0,0,4.5"
                               VerticalAlignment="Bottom"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="12.75"
                               FontWeight="Medium"
                               Foreground="#6B6B6B" />
                </StackPanel>
                <ProgressBar Margin="0,9,0,0"
                             Maximum="100"
                             Value="{Binding PrimaryRemainingPercent, Mode=OneWay}"
                             Foreground="{Binding PrimaryProgressBrush}"
                             Style="{StaticResource ReferenceUsageProgress}" />
                <StackPanel Orientation="Horizontal" Margin="0,7.5,0,0">
                    <Viewbox Width="16.5" Height="16.5" Margin="0,0,6,0">
                        <Canvas Width="25" Height="25">
                            <Ellipse Canvas.Left="3.5" Canvas.Top="3.5" Width="18" Height="18"
                                     Stroke="{DynamicResource TextSecondary}" StrokeThickness="2" />
                            <Path Data="M12.5,7.5 V12.2 L15.7,14.2"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding PrimaryResetText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="10.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1"
                    Width="1"
                    Margin="0,3,0,3"
                    Background="{DynamicResource DividerBrush}"
                    Opacity="0.85" />

            <StackPanel Grid.Column="2"
                        Margin="16.5,0,0,0"
                        Visibility="{Binding HasWeeklyLimit, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{localization:Loc Usage_WeeklyLimit}"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding WeeklyRemainingNumberText}"
                               Margin="0,3,0,-3"
                               FontFamily="{StaticResource NumericFont}"
                               FontSize="42"
                               FontWeight="Bold"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{Binding WeeklyRemainingBrush}" />
                    <TextBlock Text="%"
                               Margin="1.5,0,0,0"
                               VerticalAlignment="Bottom"
                               FontFamily="{StaticResource NumericFont}"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{Binding WeeklyRemainingBrush}" />
                    <TextBlock Text="{localization:Loc Usage_RemainingShort}"
                               Margin="6,0,0,4.5"
                               VerticalAlignment="Bottom"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="12.75"
                               FontWeight="Medium"
                               Foreground="#6B6B6B" />
                </StackPanel>
                <ProgressBar Margin="0,9,0,0"
                             Maximum="100"
                             Value="{Binding WeeklyRemainingPercent, Mode=OneWay}"
                             Foreground="{Binding WeeklyProgressBrush}"
                             Style="{StaticResource ReferenceUsageProgress}" />
                <StackPanel Orientation="Horizontal" Margin="0,7.5,0,0">
                    <Viewbox Width="16.5" Height="16.5" Margin="0,0,6,0">
                        <Canvas Width="25" Height="25">
                            <Rectangle Canvas.Left="3.5" Canvas.Top="5.5" Width="18" Height="16"
                                       RadiusX="2" RadiusY="2"
                                       Stroke="{DynamicResource TextSecondary}" StrokeThickness="2" />
                            <Path Data="M3.5,10 H21.5 M8,3 V7 M17,3 V7"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding WeeklyResetText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="10.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Grid.ColumnSpan="3"
                Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="0,9,0,0"
                Padding="9,6"
                Background="{DynamicResource NoticeBackgroundBrush}"
                CornerRadius="6">
            <TextBlock Text="{Binding WarningText}"
                       TextWrapping="Wrap"
                       Style="{StaticResource SupportingText}"
                       FontSize="10.5"
                       Foreground="{DynamicResource NoticeForegroundBrush}" />
        </Border>
    </Grid>
</UserControl>
