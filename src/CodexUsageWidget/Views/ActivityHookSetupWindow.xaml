<Window x:Class="CodexUsageWidget.Views.ActivityHookSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex activity dots"
        Width="516"
        MaxHeight="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindow}">
    <Border Style="{StaticResource DialogSurface}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                    <Canvas Width="42" Height="24" Margin="0,1,14,0">
                        <Ellipse Canvas.Left="1" Canvas.Top="9" Width="6" Height="6" Fill="{DynamicResource TextTertiary}" />
                        <Ellipse Canvas.Left="18" Canvas.Top="9" Width="6" Height="6" Fill="{DynamicResource TextSecondary}" />
                        <Ellipse Canvas.Left="35" Canvas.Top="9" Width="6" Height="6" Fill="{DynamicResource TextPrimary}" />
                    </Canvas>
                    <StackPanel>
                        <TextBlock Text="Activity dots"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Local Codex lifecycle integration"
                                   Margin="0,1,0,0"
                                   Style="{StaticResource SupportingText}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Margin="12,-4,-4,0"
                        VerticalAlignment="Top"
                        ToolTip="Close"
                        Click="CloseButton_OnClick"
                        Style="{StaticResource IconButton}">
                    <Path Width="10"
                          Height="10"
                          Data="M 1,1 L 9,9 M 9,1 L 1,9"
                          Stretch="Fill"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,16,0,8"
                    Style="{StaticResource SectionCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,1,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding StatusBrush}" />
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}"
                               Margin="0,7,0,0"
                               TextWrapping="Wrap"
                               LineHeight="17"
                               Style="{StaticResource SupportingText}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Padding="11,9"
                    Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Text="Privacy: only activity type, session ID, and turn ID travel through a local user-only pipe. Prompts and responses never leave Codex."
                           TextWrapping="Wrap"
                           LineHeight="16"
                           FontSize="10.5"
                           Foreground="{DynamicResource TextTertiary}" />
            </Border>

            <TextBlock x:Name="InstructionText"
                       Grid.Row="3"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Style="{StaticResource SupportingText}" />

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button Content="Check again"
                            IsEnabled="{Binding CanRefresh}"
                            Click="RefreshButton_OnClick"
                            Style="{StaticResource DialogButton}" />
                    <Button Content="Remove hooks"
                            Margin="8,0,0,0"
                            Visibility="{Binding CanUninstall, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="UninstallButton_OnClick"
                            Style="{StaticResource DangerDialogButton}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{Binding InstallActionLabel}"
                            Visibility="{Binding CanInstall, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="InstallButton_OnClick"
                            Style="{StaticResource PrimaryDialogButton}" />
                    <Button Content="{Binding CodexActionLabel}"
                            ToolTip="Copies /hooks and opens Codex"
                            Visibility="{Binding CanOpenCodex, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="OpenCodexButton_OnClick"
                            Style="{StaticResource PrimaryDialogButton}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
